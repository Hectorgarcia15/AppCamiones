{
  "expo": {
        "name": "HECGAR GPS",
    "description": "Sistema de Monitoreo Vehicular",
    
    "slug": "appcamiones-nueva",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
  "expo-font",
  [
    "expo-splash-screen",
    {
      "image": "./assets/icon.png",
      "backgroundColor": "#0f172a",
      "imageWidth": 200
    }
  ],
  [
    "expo-build-properties",
    {
      "android": {
        "usesCleartextTraffic": true
      }
    }
  ],
  [
    "expo-notifications",
    {
      "icon": "./assets/icon.png",
      "color": "#FFD500",
      "sounds": ["./assets/sounds/pinpin5.wav"]
    }
  ]
],
    "android": {
      "package": "com.hector.appcamiones",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC22YFVXUw5sPeJjEX23U5Skxjc5nUAiYE"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "880a6ed2-5739-452f-8a41-dbda59d38965"
      }
    },
    "owner": "mis-proyectos"
  }
}
