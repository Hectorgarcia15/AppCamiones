      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-hector": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_OWNER_TOKEN": "HECTOR01"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
